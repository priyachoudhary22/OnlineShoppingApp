@using OnlineShoppingApp.Extensions
@model List<OnlineShoppingApp.Models.Product>

@{
    // Sets the page title.
    ViewData["Title"] = "Products";
}

<!-- Displays the main heading. -->
<h1>Online Shopping Products</h1>

<!-- Displays product information in a table. -->
<table class="table table-bordered table-striped">

    <!-- Defines the table header. -->
    <thead>
        <tr>
            <th>ID</th>
            <th>Product</th>
            <th>Category</th>
            <th>Original Price</th>
            <th>Discount</th>
            <th>Selling Price</th>
            <th>Action</th>
        </tr>
    </thead>

    <!-- Displays product records. -->
    <tbody>

        @foreach (var product in Model)
        {
            <tr>
                <!-- Displays product ID. -->
                <td>@product.ProductId</td>

                <!-- Displays product name. -->
                <td>@product.ProductName</td>

                <!-- Displays category. -->
                <td>@product.Category</td>

                <!-- Displays original price. -->
                <td>₹@product.Price</td>

                <!-- Displays discount percentage. -->
                <td>@product.DiscountPercentage%</td>

                <!-- Calculates and displays discounted price. -->
                <td>
                    ₹@product.GetDiscountedPrice()
                </td>

                <!-- Passes ProductId through query string. -->
                <td>
                    <a asp-action="Details"
                       asp-route-id="@product.ProductId"
                       class="btn btn-primary">
                        Details
                    </a>
                </td>
            </tr>
        }

    </tbody>
</table>

<!-- Opens the external API products page. -->
<a asp-action="ProductsApi"
   class="btn btn-success">
    View API Products
</a>